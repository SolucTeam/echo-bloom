# Standalone installation STILL requires self-hosted Supabase auth/data/storage.
# Install that distribution separately; compose.yaml does not include it.
# Use only keys and URLs from your own installation, never the Lovable Cloud project.
# Public production configuration, replace on your own server.
SITE_URL=https://your-site.example
PUBLIC_BACKEND_URL=https://your-content.example
INTERNAL_BACKEND_URL=http://kong:8000
# Example only: set the real shared Docker network name from your installation.
BACKEND_NETWORK=supabase_default
# Same-machine test only (configure auth URLs too; rebuild when changing URLs):
# SITE_URL=http://localhost:3000
# PUBLIC_BACKEND_URL=http://localhost:8000
# Keep INTERNAL_BACKEND_URL reachable from containers, not localhost.
# Fill from your self-hosted service's secured configuration, never commit it.
ANON_KEY=
SERVICE_ROLE_KEY=
# Administrator email and absolute path to a private password file on the host.
# The password itself must NOT be stored here; use at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD_FILE=

# Optional private SMTP worker, enabled with --profile mail.
MAIL_WORKER_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Private host file containing only the SMTP password, readable by container UID 1000.
SMTP_PASSWORD_FILE=/etc/green-ivory/smtp-password